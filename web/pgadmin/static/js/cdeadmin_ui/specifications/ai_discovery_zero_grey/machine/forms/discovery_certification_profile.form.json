{
  "form_id": "discovery.certification_profile",
  "module": "cdeadmin.discovery_intelligence",
  "title": "Certification Criteria Profile",
  "kind": "surface_form",
  "size": "workbench",
  "purpose": "Define evidence required to certify a product/resource/metric.",
  "sections": [
    {
      "id": "identity",
      "title": "Profile",
      "fields": [
        {
          "id": "name",
          "label": "Name",
          "component": "TextField",
          "required": true,
          "default": "",
          "validation": "1-120 chars.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "target_types",
          "label": "Applicable entity classes",
          "component": "MultiSelect",
          "required": true,
          "default": [],
          "validation": "Known discoverable classes.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "expiration_days",
          "label": "Default certification days",
          "component": "NumberField",
          "required": false,
          "default": 365,
          "validation": "1..site max or explicit no-expiry policy.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        }
      ]
    },
    {
      "id": "criteria",
      "title": "Criteria",
      "fields": [
        {
          "id": "criteria",
          "label": "Required checks",
          "component": "DataGrid",
          "required": true,
          "default": null,
          "validation": "Every row has id, required flag, source/evidence rule.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "require_owner",
          "label": "Require owner",
          "component": "Checkbox",
          "required": true,
          "default": true,
          "validation": "Boolean.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "require_contract",
          "label": "Require contract",
          "component": "Checkbox",
          "required": true,
          "default": false,
          "validation": "Boolean.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "require_quality",
          "label": "Require passing quality",
          "component": "Checkbox",
          "required": true,
          "default": true,
          "validation": "Boolean.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        }
      ]
    }
