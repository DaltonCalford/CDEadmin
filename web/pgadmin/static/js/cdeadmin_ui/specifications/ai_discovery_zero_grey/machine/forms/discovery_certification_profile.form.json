  "actions": [
    {
      "id": "save",
      "label": "Save Profile",
      "intent": "primary",
      "default": true,
      "closes": false,
      "enabled_when": "criteria valid",
      "command": null
    }
  ],
  "states": [
    "default",
    "loading",
    "invalid",
    "permission-denied",
    "error"
  ],
  "keyboard": "Tab order follows visual order; Enter invokes default only when no multiline/editor control owns Enter; Esc cancels modal forms; all pickers support keyboard search.",
  "security_notes": [
    "Certification criteria are versioned; changing profile does not retroactively rewrite historical certification evidence."
  ],
  "spec_gaps": []
}