          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "query",
          "label": "Search query",
          "component": "SearchField",
          "required": true,
          "default": "",
          "validation": "1-1000 chars.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "ranking",
          "label": "Ranking profile",
          "component": "Select",
          "required": true,
