{
  "form_id": "ai.resource_scope",
  "module": "cdeadmin.ai_interface",
  "title": "AI Resource Scope",
  "kind": "surface_form",
  "size": "large",
  "purpose": "Constrain a connector/profile to explicitly allowed/blocked database resources.",
  "sections": [
    {
      "id": "scope",
      "title": "Scope",
      "fields": [
        {
          "id": "allow",
          "label": "Allowed namespaces/resources",
          "component": "ResourcePicker",
          "required": false,
          "default": [],
          "validation": "Visible to administrator and valid for connector.",
          "help": "Empty means inherit parent policy, not all.",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "deny",
          "label": "Denied namespaces/resources",
          "component": "ResourcePicker",
          "required": false,
          "default": [],
          "validation": "Block wins over allow.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "children",
          "label": "Include descendants",
          "component": "Checkbox",
          "required": true,
          "default": true,
          "validation": "Boolean.",
          "help": "Recursive-schema behavior is explicit.",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "future_children",
          "label": "Include future descendants",
          "component": "Checkbox",
          "required": true,
          "default": false,
          "validation": "Boolean.",
          "help": "High-risk for broad scopes; default false.",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        }
      ]
    },
    {
      "id": "scratchbird",
      "title": "ScratchBird",
      "fields": [
        {
          "id": "surface_scope",
          "label": "Allowed access surfaces",
          "component": "MultiSelect",
          "required": false,
          "default": [],
          "validation": "Only visible for ScratchBird connector.",
          "help": "",
          "secret": false,
          "visibility": "connector.provider == scratchbird",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "cross_surface",
          "label": "Allow SBsql cross-surface query",
          "component": "Checkbox",
          "required": true,
          "default": false,
          "validation": "Only SBsql + engine-authorized.",
          "help": "",
          "secret": false,
          "visibility": "connector.kind == scratchbird_sbsql",
          "enabled": "engine capability and site policy permit",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "save",
      "label": "Save Scope",
      "intent": "primary",
      "default": true,
      "closes": false,
      "enabled_when": "scope resolves and no invalid alias leak",
      "command": null
    }
  ],
  "states": [
    "default",
    "loading",
    "invalid",
    "permission-denied",
    "error"
  ],
  "keyboard": "Tab order follows visual order; Enter invokes default only when no multiline/editor control owns Enter; Esc cancels modal forms; all pickers support keyboard search.",
  "security_notes": [
    "Compatibility parser scope may never include sibling workareas.",
    "Deny always wins."
  ],
  "spec_gaps": []
}