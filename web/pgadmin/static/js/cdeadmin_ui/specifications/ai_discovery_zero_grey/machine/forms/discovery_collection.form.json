          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "scope",
          "label": "Scope",
          "component": "Select",
          "required": true,
          "default": "private",
          "validation": "Allowed scope.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [
            "private",
            "project",
            "team",
            "organization"
          ],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "description",
          "label": "Description",
          "component": "TextArea",
          "required": false,
          "default": "",
          "validation": "0-2000 chars.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "items",
          "label": "Items",
          "component": "AssetPicker",
          "required": false,
          "default": [],
          "validation": "Visible ResourceRef/AssetRef/DataProduct refs.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "cancel",
      "label": "Cancel",
      "intent": "neutral",
      "default": true,
      "closes": true,
      "enabled_when": "always",
      "command": null
    },
    {
      "id": "save",
      "label": "Save Collection",
      "intent": "primary",
      "default": false,
      "closes": true,
      "enabled_when": "name/scope valid",
      "command": null
