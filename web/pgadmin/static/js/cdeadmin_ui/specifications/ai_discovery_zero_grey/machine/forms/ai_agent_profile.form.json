          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "enabled",
          "label": "Enabled",
          "component": "ToggleSwitch",
          "required": true,
          "default": true,
          "validation": "Boolean.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "autonomy",
          "label": "Autonomy",
          "component": "Select",
          "required": true,
          "default": "READ_ONLY_TOOLS",
          "validation": "One mode.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [
            "ASK_ONLY",
            "DRAFT_ONLY",
            "READ_ONLY_TOOLS",
            "BOUNDED_EXECUTION"
          ],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        }
      ]
    },
