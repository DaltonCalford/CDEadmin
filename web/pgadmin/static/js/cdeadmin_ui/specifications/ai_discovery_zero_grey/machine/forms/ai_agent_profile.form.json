        {
          "id": "name",
          "label": "Name",
          "component": "TextField",
          "required": true,
          "default": "",
          "validation": "1-120 chars.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "description",
          "label": "Description",
          "component": "TextArea",
          "required": false,
          "default": "",
          "validation": "0-4000 chars.",
