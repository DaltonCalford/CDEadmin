  "actions": [
    {
      "id": "clone",
      "label": "Clone",
      "intent": "neutral",
      "default": false,
      "closes": false,
      "enabled_when": "profile exists",
      "command": "ai.agent_profile.clone"
    },
    {
      "id": "save",
      "label": "Save",
      "intent": "primary",
      "default": true,
      "closes": false,
      "enabled_when": "all refs valid",
      "command": "ai.agent_profile.update"
    },
    {
      "id": "disable",
      "label": "Disable",
      "intent": "warning",
      "default": false,
      "closes": false,
      "enabled_when": "profile exists",
      "command": "ai.agent_profile.disable"
    }
