  "actions": [
    {
      "id": "cancel",
      "label": "Cancel",
      "intent": "neutral",
      "default": true,
      "closes": true,
      "enabled_when": "always",
      "command": null
    },
    {
      "id": "submit",
      "label": "Record Review",
      "intent": "primary",
      "default": false,
      "closes": true,
      "enabled_when": "criteria/decision valid",
      "command": "discovery.certification.review"
    }
  ],
  "states": [
    "default",
    "loading",
    "invalid",
    "permission-denied",
    "error"
