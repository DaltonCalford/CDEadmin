          "required": true,
          "default": null,
          "validation": "Exact revision selected.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "readonly",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "revision",
          "label": "Revision",
          "component": "TextField",
          "required": true,
          "default": null,
          "validation": "Read-only.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "readonly",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "criteria",
          "label": "Criteria",
          "component": "DataGrid",
          "required": true,
          "default": null,
          "validation": "All criteria have result/evidence.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "readonly",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        }
      ]
    },
    {
      "id": "decision",
      "title": "Decision",
      "fields": [
        {
          "id": "decision",
          "label": "Decision",
          "component": "Select",
          "required": true,
          "default": "CERTIFIED",
          "validation": "One decision.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [
            "CERTIFIED",
            "CERTIFIED_WITH_CONDITIONS",
            "REJECTED"
          ],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "conditions",
          "label": "Conditions",
          "component": "TextArea",
          "required": false,
          "default": "",
          "validation": "Required if conditional.",
          "help": "",
