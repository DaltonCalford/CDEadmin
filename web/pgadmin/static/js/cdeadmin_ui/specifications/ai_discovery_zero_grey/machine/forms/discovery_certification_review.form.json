          "visibility": "decision == CERTIFIED_WITH_CONDITIONS",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "expires",
          "label": "Expiration",
          "component": "DateField",
          "required": false,
          "default": null,
          "validation": "Must be future if set.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        },
        {
          "id": "notes",
          "label": "Review notes",
          "component": "TextArea",
          "required": true,
          "default": "",
          "validation": "1-4000 chars.",
          "help": "",
          "secret": false,
          "visibility": "always",
          "enabled": "always",
          "options": [],
          "placeholder": null,
          "binds_to": null,
          "warning": null
        }
      ]
    }
