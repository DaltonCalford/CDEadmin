{
  "schema": "cdeadmin.artwork-catalog.v1",
  "root": "/static/assets/cdeadmin",
  "collections": {
    "branding": {
      "path": "branding",
      "formats": ["svg"],
      "customizable": false
    },
    "engines": {
      "path": "engines",
      "formats": ["svg"],
      "customizable": true
    },
    "commands": {
      "path": "commands",
      "formats": ["svg"],
      "customizable": true,
      "license": "MIT",
      "attribution": "Hugeicons Free Icons 4.3.0"
    },
    "authentication": {
      "path": "auth",
      "formats": ["svg"],
      "customizable": false
    },
    "objects": {
      "path": "objects",
      "formats": ["svg"],
      "customizable": true,
      "license": "PostgreSQL",
      "attribution": "pgAdmin Development Team"
    },
    "explain": {
      "path": "explain",
      "formats": ["svg"],
      "customizable": true,
      "license": "PostgreSQL",
      "attribution": "pgAdmin Development Team"
    },
    "controls": {
      "path": "controls",
      "formats": ["svg", "gif"],
      "customizable": true,
      "license": "PostgreSQL",
      "attribution": "pgAdmin Development Team"
    },
    "themes": {
      "path": "themes",
      "formats": ["png"],
      "customizable": true
    },
    "backgrounds": {
      "path": "backgrounds",
      "formats": ["svg"],
      "customizable": true
    },
    "tools": {
      "path": "tools",
      "formats": ["svg"],
      "customizable": true,
      "license": "PostgreSQL",
      "attribution": "pgAdmin Development Team"
    },
    "profiles": {
      "path": "profiles",
      "formats": ["json"],
      "customizable": false
    }
  },
  "assignment_contract": "cdeadmin.icon-assignments.v1",
  "rule": "Runtime code consumes semantic icon keys; only this catalog owns physical CDEadmin artwork paths."
}
