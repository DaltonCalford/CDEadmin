{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdeadmin.invalid/schemas/scratchbird-consumer-contract-v1.json",
  "title": "CDEadmin ScratchBird consumer contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "contract_version", "adapter_manifest_schema",
    "response_schema", "provider_mode", "adapter_version_policy",
    "methods", "method_contracts", "identity_policy", "secret_policy",
    "authority_invariants", "transaction_policy"
  ],
  "properties": {
    "schema": {"const": "cdeadmin.scratchbird-consumer-contract.v1"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "adapter_manifest_schema": {"const": "cdeadmin.scratchbird-driver-adapter-manifest.v1"},
    "response_schema": {"const": "cdeadmin.scratchbird-response.v1"},
    "provider_mode": {"const": "scratchbird_native"},
    "adapter_version_policy": {"type": "object"},
    "methods": {"type": "array", "minItems": 13, "uniqueItems": true, "items": {"type": "string"}},
    "method_contracts": {"type": "object", "minProperties": 13},
    "identity_policy": {"type": "object"},
    "secret_policy": {"type": "object"},
    "authority_invariants": {"type": "object"},
    "transaction_policy": {"type": "object"}
  }
}
