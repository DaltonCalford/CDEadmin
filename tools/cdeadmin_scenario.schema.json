{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdeadmin.scenario-catalog.v1",
  "title": "CDEadmin differential scenario catalog",
  "type": "object",
  "required": ["schema", "catalog_id", "fixture_manifest", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "cdeadmin.scenario-catalog.v1"},
    "catalog_id": {"type": "string", "minLength": 1},
    "fixture_manifest": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scenario_id", "feature_id", "model", "fixture_set",
          "applies_to", "operations", "expected_reference"
        ],
        "additionalProperties": false,
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "feature_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "model": {
            "enum": [
              "relational", "document", "graph", "vector", "timeseries",
              "search", "key_value", "distributed", "versioned",
              "columnar", "metadata", "diagnostic", "security"
            ]
          },
          "fixture_set": {"type": "string", "minLength": 1},
          "applies_to": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
          },
          "operations": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["operation_key", "arguments"],
              "additionalProperties": false,
              "properties": {
                "operation_key": {
                  "type": "string", "pattern": "^[a-z0-9_.-]+$"
                },
                "arguments": {"type": "object"}
              }
            }
          },
          "expected_reference": {
            "type": "object",
            "required": ["disposition", "observation_kind"],
            "additionalProperties": false,
            "properties": {
              "disposition": {"enum": ["observe", "expected_refusal"]},
              "observation_kind": {
                "enum": [
                  "scalar", "table", "document", "graph", "vector",
                  "timeseries", "search", "state", "metadata", "diagnostic"
                ]
              },
              "diagnostic_code": {"type": "string"}
            }
          },
          "transaction_observation": {
            "type": "object",
            "required": [
              "reference_authority", "scratchbird_authority",
              "common_runner_interprets_finality"
            ],
            "additionalProperties": false,
            "properties": {
              "reference_authority": {"const": "provider_native_opaque"},
              "scratchbird_authority": {"const": "scratchbird_engine_mga"},
              "common_runner_interprets_finality": {"const": false}
            }
          }
        }
      }
    }
  }
}
